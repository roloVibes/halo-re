{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolovibes.example/halo-re/playbook.schema.json",
  "title": "Halo RE playbook",
  "description": "Structured, versioned reverse-engineering workflow. Model-independent: a playbook never names a model or provider. Binary RE is read-only toward the world by default: importing a binary into the LOCAL Ghidra project is 'low-impact' (a local side effect, nothing sent anywhere); every stage names its impact class.",
  "type": "object",
  "required": ["playbook_id", "version", "category", "objective", "phase", "assigned_role", "prerequisites", "scope_requirements", "stages", "completion_criteria", "finding_classification"],
  "additionalProperties": false,
  "properties": {
    "playbook_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "title": { "type": "string" },
    "category": { "type": "string", "description": "e.g. triage, audit, diff, static, reporting" },
    "phase": { "type": "string", "enum": ["triage", "audit", "diff", "static", "reporting"] },
    "objective": { "type": "string" },
    "methodology_refs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "e.g. CWE-787 pattern families, MS docs on IRP major codes, the pack's own skill names."
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "enum": ["binary", "patched-binary", "diff-artifact", "decompiled-tree", "documentation", "tool"] },
          "detail": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "scope_requirements": {
      "type": "object",
      "properties": {
        "required_activities": {
          "type": "array",
          "items": { "type": "string", "enum": ["static-analysis", "decompilation-review", "disassembly-review", "string-analysis", "diff-analysis", "tool-driven-querying", "reporting"] }
        },
        "target_kinds": { "type": "array", "items": { "type": "string" }, "description": "e.g. pe-driver, mach-o, elf, dylib" }
      },
      "additionalProperties": false
    },
    "assigned_role": { "type": "string", "enum": ["triage", "analyst", "vuln-reviewer", "reporter", "orchestrator"] },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "impact"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "impact": { "type": "string", "enum": ["read-only", "low-impact"] },
          "expected_observations": { "type": "array", "items": { "type": "string" } },
          "evidence_requirements": { "type": "array", "items": { "type": "string" } },
          "limits": {
            "type": "object",
            "properties": {
              "max_functions": { "type": "integer", "minimum": 1 },
              "timeout": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "resource_limits": {
      "type": "object",
      "properties": {
        "max_budget_usd": { "type": "number", "minimum": 0 },
        "max_duration": { "type": "string" }
      },
      "additionalProperties": false
    },
    "completion_criteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "finding_classification": { "type": "string" },
    "judge_requirements": {
      "type": "object",
      "properties": {
        "required": { "type": "boolean", "default": true },
        "independent_validation": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    }
  }
}
